"""
弹幕 AI 生成器 - 截屏 + 视觉模型分析
调用 siliconflow Qwen3.5-VL 分析画面，生成弹幕
"""
import time
import base64
import io
import threading
from pathlib import Path

import mss
import mss.tools
from PIL import Image


class DanmuAI:
    """截屏 + AI 生成弹幕。"""

    def __init__(self, overlay, config: dict, interval: float = 5.0, dedup_seconds: float = 15.0):
        self.overlay = overlay
        self.config = config
        self.interval = interval  # 截图间隔（秒）
        self.dedup_seconds = dedup_seconds  # 去重窗口（秒）
        self._recent: list = []  # (text, timestamp)
        self._last_track_time: dict = {}  # track -> last emit time
        self.running = False
        self._thread = None

    def start(self):
        """启动后台截屏线程。"""
        self.running = True
        self._thread = threading.Thread(target=self._loop, daemon=True)
        self._thread.start()
        print('[ai] 截屏+AI 弹幕生成已启动', flush=True)

    def stop(self):
        self.running = False

    def _loop(self):
        """后台循环：截屏 → AI → 弹幕。"""
        while self.running:
            try:
                self._capture_and_generate()
            except Exception as e:
                print(f'[ai] 错误: {e}', flush=True)
            time.sleep(self.interval)

    def _capture_and_generate(self):
        """截屏并调用 AI 生成弹幕。"""
        # 截取主屏幕（is_primary=True）
        with mss.mss() as sct:
            primary = next((m for m in sct.monitors if m.get('is_primary')), sct.monitors[1])
            screenshot = sct.grab(primary)
            img = Image.frombytes('RGB', screenshot.size, screenshot.rgb)

        # 压缩图片（缩小分辨率，减少 token 消耗）
        img.thumbnail((1280, 720), Image.Resampling.LANCZOS)

        # 转 base64
        buf = io.BytesIO()
        img.save(buf, format='JPEG', quality=75)
        b64 = base64.b64encode(buf.getvalue()).decode('utf-8')

        # 调用 AI（根据配置的风格选择 prompt）
        style = self.config.get("danmu_ai_style", "pi")
        recent_texts = [t for t, _ in self._recent[-10:]]
        prompt = self._get_prompt_by_style(style, recent_texts)

        # 重试机制：最多 2 次
        danmu_list = []
        for attempt in range(2):
            danmu_list = self._call_vision_api(prompt, b64)
            if danmu_list:
                break
            print(f'[ai] 第 {attempt+1} 次调用失败，准备重试...', flush=True)
            time.sleep(1)

        # 去重 + 逐条间隔发送到浮层
        if danmu_list:
            now = time.time()
            self._recent = [(t, ts) for t, ts in self._recent if now - ts < self.dedup_seconds]

            valid = []
            for text in danmu_list:
                if any(t == text for t, _ in self._recent):
                    continue
                # 相似内容去重（包含关系/字符重叠率）
                if self._is_similar(text, self._recent):
                    continue
                self._recent.append((text, now))
                valid.append(text)

            # 逐条间隔发送
            for i, text in enumerate(valid):
                time.sleep(0.6)
                self.overlay.add_danmu(text)
            if valid:
                print(f'[ai] 逐条发送: {valid}', flush=True)

    def _is_similar(self, text: str, recent: list, threshold: float = 0.5) -> bool:
        """检查 text 是否和 recent 中的某条相似。"""
        for t, _ in recent:
            # 包含关系
            if text in t or t in text:
                return True
            # 字符重叠率
            shorter = text if len(text) < len(t) else t
            longer = t if len(text) < len(t) else text
            if len(shorter) == 0:
                continue
            overlap = sum(1 for c in shorter if c in longer) / len(shorter)
            if overlap >= threshold:
                return True
        return False

    def _get_prompt_by_style(self, style: str, recent_danmu: list = None) -> str:
        """根据风格返回不同的 AI prompt。"""
        base = "分析这张游戏截图，用一句话生成 B 站风格弹幕评论。要求：简短（5-15字），直接输出内容，每行一条，不要编号不要解释。"

        avoid = ""
        if recent_danmu:
            avoid = f"\n最近已发的弹幕（不要重复）：{', '.join(recent_danmu[-8:])}"

        styles = {
            "pi": base + " 风格要皮、要玩梗、要吐槽。" + avoid,
            "normal": base + " 风格自然随意。" + avoid,
            "serious": base + " 风格正经，多描述画面。" + avoid,
        }
        return styles.get(style, styles["pi"])

    def generate_from_voice(self, text: str) -> str:
        """根据用户语音内容 + 当前截图，生成互动弹幕。"""
        try:
            # 截取当前画面
            import mss
            from PIL import Image
            with mss.mss() as sct:
                primary = next((m for m in sct.monitors if m.get('is_primary')), sct.monitors[1])
                screenshot = sct.grab(primary)
                img = Image.frombytes('RGB', screenshot.size, screenshot.rgb)
            img.thumbnail((640, 360), Image.Resampling.LANCZOS)
            buf = __import__('io').BytesIO()
            img.save(buf, format='JPEG', quality=60)
            b64 = __import__('base64').b64encode(buf.getvalue()).decode('utf-8')

            prompt = f"""玩家说：「{text}」
结合游戏画面，生成一条 B 站弹幕回复。5-15字，简短，每行一条，不要编号。"""

            result = self._call_vision_api(prompt, b64)
            if result:
                return result[0]
            return ""
        except Exception as e:
            print(f'[voice-ai] 生成失败: {e}', flush=True)
            return ""

    def _call_vision_api(self, prompt: str, image_b64: str) -> list:
        """调用视觉模型 API（从 config 读取配置）。"""
        try:
            import urllib.request
            import json

            cfg = self.config.get("vision_api", {})
            provider = cfg.get("provider", "siliconflow")
            base_url = cfg.get("base_url", "https://api.siliconflow.cn/v1")
            model = cfg.get("model", "Qwen/Qwen3.5-397B-A17B")
            api_key = cfg.get("api_key", "")

            # 兼容不同提供商的 endpoint 格式
            if provider in ("siliconflow", "openai", "dashscope", "openrouter"):
                url = f"{base_url}/chat/completions"
            elif provider == "volcengine":
                url = f"{base_url}/chat/completions"
            else:
                url = f"{base_url}/chat/completions"

            payload = {
                "model": model,
                "messages": [
                    {
                        "role": "user",
                        "content": [
                            {"type": "text", "text": prompt},
                            {
                                "type": "image_url",
                                "image_url": {
                                    "url": f"data:image/jpeg;base64,{image_b64}"
                                }
                            }
                        ]
                    }
                ],
                "max_tokens": 200,
                "temperature": 0.8,
            }

            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode('utf-8'),
                headers={
                    "Content-Type": "application/json",
                    "Authorization": f"Bearer {api_key}",
                },
                method="POST",
            )

            with urllib.request.urlopen(req, timeout=60) as resp:
                result = json.loads(resp.read().decode('utf-8'))

            content = result.get('choices', [{}])[0].get('message', {}).get('content', '')
            # 推理模型：内容在 reasoning 字段，取最后一句作为答案
            if not content:
                content = result.get('choices', [{}])[0].get('message', {}).get('reasoning', '')
                if not content:
                    content = result.get('choices', [{}])[0].get('message', {}).get('reasoning_content', '')
                # 取最后一句（结论）
                lines = content.strip().split('\n')
                content = lines[-1].strip() if lines else content[:200]
            else:
                lines = content.strip().split('\n')
                content = lines[-1].strip() if lines else content[:200]
            return [content] if content else []

        except Exception as e:
            print(f'[ai] API 调用失败: {e}', flush=True)
            return []


if __name__ == "__main__":
    # 测试
    from danmu_overlay_pyqt import DanmuOverlay, DanmuEngine
    from PyQt6.QtWidgets import QApplication
    import sys

    app = QApplication(sys.argv)
    engine = DanmuEngine(800, 150, tracks=3)
    overlay = DanmuOverlay(engine)
    overlay.show_for_screen(0, 0)

    ai = DanmuAI(overlay, interval=8.0)
    ai.start()

    sys.exit(app.exec())
